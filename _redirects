# --- Kanonischer Hostname: www -> ohne www -------------------------------------------
# Befund 26.08.2026: www UND ohne www lieferten beide HTTP 200 - dieselbe Seite unter
# zwei Hostnamen. Das Canonical zeigt auf die Variante OHNE www, also leitet www dorthin.
# Ohne diese Regel verteilen sich Crawl-Budget und Links auf zwei Hosts, und die
# Ads-Zielseiten-URL kann von der tatsaechlich ausgelieferten abweichen.
# Das "!" erzwingt die Weiterleitung auch dann, wenn die Datei existiert.
https://www.versicherungs-fuchs.online/*   https://versicherungs-fuchs.online/:splat   301!

# Pretty-URLs für VersicherungsFuchs — Sevalla unterstützt Netlify-style _redirects
# Status 200 = rewrite (URL bleibt), 301 = permanent redirect (URL wechselt)

# Pretty-URLs ohne .html
/datenschutz       /datenschutz.html        200
/impressum         /impressum.html          200
/bildnachweis       /bildnachweis.html        200
/widerrufsbelehrung       /widerrufsbelehrung.html        200
/erstinformation       /erstinformation.html        200

# Alte Stubs (refresh-meta) als Redirects
/riester-check-start.html      /riester-check/start/      301
/riester-check-question.html   /riester-check/q/          301
/riester-check-result.html     /riester-check/result/     301

# Eine URL-Form (Index-Status 08.10.2026): Inhaltsseiten enden auf "/", ohne .html.
# Die alten .html-Dateien sind entfernt bzw. in Verzeichnisse verschoben, daher greifen diese Regeln
# ohne "!". /x (ohne Schraegstrich) liefert Sevalla aus dem Verzeichnis aus, Canonical = /x/.
# Bewusst KEINE Regel /x -> /x/: Netlify-artige Auswertung normalisiert den Schraegstrich beim Abgleich,
# das ergaebe eine Weiterleitungsschleife (ungetestet auf Sevalla - nicht riskieren).
/bu-check.html          /bu-check/          301
/baufi-check.html       /baufi-check/       301
/renten-check.html      /renten-check/      301
/pkv-check.html         /pkv-check/         301
/riester-check.html     /riester-check/     301
/news.html              /news/              301
/article.html           /news/              301
